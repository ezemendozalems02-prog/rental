# ─────────────────────────────────────────────────────────────
# GT Rental — variables de entorno
# Versión DEMO: ninguna es obligatoria. Sin valores, el sitio
# funciona en modo demostración (datos guardados en el navegador).
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.ejemplo-gtrental.com.ar

# WhatsApp comercial confirmado, solo dígitos con código de país (ej: 549XXXXXXXXXX).
# Si queda vacío, los botones abren WhatsApp para que la persona elija el contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo comercial y de contacto confirmados (se muestran en footer/contacto)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Producción (no usadas en la demo) ────────────────────────
# GT_RENTAL_LEADS_EMAIL=
# RESEND_API_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
